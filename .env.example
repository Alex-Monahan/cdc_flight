# Copy to .env and source it, or just export these. Every value below is the default
# baked into src/cdc_flight/config.py - you only need to set what you want to change.

# --- source: the project-local Postgres cluster (scripts/pg.sh) ----------------
PGHOST=127.0.0.1
PGPORT=15432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cdc_source
CDC_SCHEMA=app
CDC_TABLES=customers,orders,sensor_readings,documents,wide_types,audit_log

# --- replication ---------------------------------------------------------------
CDC_SLOT_NAME=cdc_flight_slot
CDC_PUBLICATION=cdc_flight_pub
CDC_TOPIC_PREFIX=cdcflight
CDC_SNAPSHOT_MODE=initial
CDC_STATE_DIR=./.cdc_state

# --- destination ----------------------------------------------------------------
CDC_DESTINATION=duckdb            # duckdb | motherduck
CDC_PIPELINE_NAME=cdc_flight
CDC_DATASET=cdc_raw
CDC_DUCKDB_PATH=./cdc_flight.duckdb
CDC_MD_DATABASE=cdc_flight_dev

# MotherDuck token. The lowercase spelling is what the MotherDuck tooling exports;
# MOTHERDUCK_TOKEN works too. NEVER commit a real token.
# motherduck_token=

# --- run bounds -----------------------------------------------------------------
CDC_MAX_SECONDS=90
CDC_IDLE_SECONDS=8
CDC_MIN_RECORDS=0

# --- misc -----------------------------------------------------------------------
RUNTIME__DLTHUB_TELEMETRY=false
# Extra JVM options for the embedded Debezium engine (default: -Xms256m -Xmx2g -XX:+UseG1GC)
# PYDBZ_JVM_OPTS=-Xms256m -Xmx2g -XX:+UseG1GC
