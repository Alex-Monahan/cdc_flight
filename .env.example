# Copy to .env and source it, or just export these. The CDC_TEST_* values are the
# per-Postgres-instance knobs; physical paths derive from the port and logical
# resource names derive from the optional instance ID.

# --- source: the project-local Postgres cluster (scripts/pg.sh) ----------------
CDC_TEST_PGPORT=15432
# Optional; defaults to pg<CDC_TEST_PGPORT>.
# CDC_TEST_INSTANCE_ID=pg15432
# At the default port this is ./.pgdata; another port derives ./.pgdata_<port>.
# The disposable provisioner refuses any non-derived data directory.
# CDC_TEST_PGSOCKET=./.pgdata
# CDC_TEST_PGLOG=./.pgdata/server.log
# Lock paths derive entirely from canonical PGDATA + host + port and cannot be
# overridden independently.
CDC_TEST_PGDATABASE=cdc_source
# Database/slot names default to these instance-scoped forms. Override only when
# integrating with another naming convention.
# CDC_TEST_TEMPLATE_DATABASE_PREFIX=cdc_flight_test_template_pg15432_
# CDC_TEST_WORKER_DATABASE_PREFIX=cdc_flight_test_pg15432_
# CDC_TEST_SLOT_PREFIX=test_slot_pg15432_
PGHOST=127.0.0.1
PGPORT=15432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cdc_source
CDC_SCHEMA=app
CDC_TABLES=customers,orders,sensor_readings,documents,wide_types,audit_log

# --- replication ---------------------------------------------------------------
# CDC_SLOT_NAME defaults to cdc_flight_slot_<CDC_TEST_INSTANCE_ID>.
CDC_SLOT_PREFIX=cdc_flight_slot_
CDC_PUBLICATION=cdc_flight_pub
CDC_TOPIC_PREFIX=cdcflight
CDC_SNAPSHOT_MODE=initial
# Defaults below are all rooted at ./.cdc_instances/<CDC_TEST_INSTANCE_ID>/.
CDC_STATE_DIR=./.cdc_instances/pg15432/cdc_state

# --- destination ----------------------------------------------------------------
CDC_DESTINATION=duckdb            # duckdb | motherduck
CDC_PIPELINE_NAME=cdc_flight_pg15432
CDC_DATASET=cdc_raw
CDC_DUCKDB_PATH=./.cdc_instances/pg15432/cdc_flight.duckdb
CDC_MD_DATABASE=cdc_flight_dev

# MotherDuck token. The lowercase spelling is what the MotherDuck tooling exports;
# MOTHERDUCK_TOKEN works too. NEVER commit a real token.
# motherduck_token=

# --- run bounds -----------------------------------------------------------------
CDC_MAX_SECONDS=90
CDC_IDLE_SECONDS=8
CDC_MIN_RECORDS=0

# --- misc -----------------------------------------------------------------------
RUNTIME__DLTHUB_TELEMETRY=false
# Extra JVM options for the embedded Debezium engine (default: -Xms256m -Xmx2g -XX:+UseG1GC)
# PYDBZ_JVM_OPTS=-Xms256m -Xmx2g -XX:+UseG1GC
